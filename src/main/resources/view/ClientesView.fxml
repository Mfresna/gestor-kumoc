<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="16"
      fx:controller="org.kumoc.controller.ClientesController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="CLIENTES" styleClass="titulo-seccion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre, CUIT o teléfono" prefWidth="300"/>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRazonSocial" text="RAZÓN SOCIAL" prefWidth="240"/>
                <TableColumn fx:id="colCuit" text="CUIT / CUIL" prefWidth="130"/>
                <TableColumn fx:id="colTipo" text="FACTURA" prefWidth="80"/>
                <TableColumn fx:id="colTelefono" text="TELÉFONO" prefWidth="130"/>
                <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>

    <VBox styleClass="tarjeta" spacing="10" prefWidth="340" minWidth="340" maxWidth="340">
        <Label fx:id="lblFormTitulo" text="NUEVO CLIENTE" styleClass="subtitulo"/>

        <VBox spacing="3">
            <Label text="RAZÓN SOCIAL *" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtRazonSocial"/>
        </VBox>
        <VBox spacing="3">
            <Label text="CUIT / CUIL *" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtCuit" promptText="20-12345678-9"/>
        </VBox>
        <VBox spacing="3">
            <Label text="TIPO DE FACTURA *" styleClass="etiqueta-campo"/>
            <ComboBox fx:id="cmbTipoFactura" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="3">
            <Label text="TELÉFONO" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtTelefono"/>
        </VBox>
        <VBox spacing="3">
            <Label text="EMAIL" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtEmail"/>
        </VBox>
        <VBox spacing="3">
            <Label text="DIRECCIÓN" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtDireccion"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>
        <HBox spacing="10">
            <Button text="Nuevo" styleClass="boton-secundario" onAction="#nuevo"/>
            <Button text="Guardar" styleClass="boton-primario" onAction="#guardar" HBox.hgrow="ALWAYS"
                    maxWidth="Infinity" defaultButton="true"/>
        </HBox>
        <Button fx:id="btnEliminar" text="Eliminar" styleClass="boton-secundario" maxWidth="Infinity"
                onAction="#eliminar"/>
    </VBox>
</HBox>
