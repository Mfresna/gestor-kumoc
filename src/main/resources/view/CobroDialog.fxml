<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="contenido" spacing="12"
      prefWidth="400" fx:controller="org.kumoc.controller.CobroDialogController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="lblTitulo" text="REGISTRAR COBRO" styleClass="subtitulo"/>
    <Label fx:id="lblDetalle" styleClass="texto-suave" wrapText="true"/>

    <VBox spacing="3">
        <Label text="FECHA DE COBRO *" styleClass="etiqueta-campo"/>
        <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
    </VBox>
    <CheckBox fx:id="chkFacturar" text="Facturar en ARCA"/>
    <Label text="Si se marca, la orden aparecerá en el listado de fin de mes de pendientes de facturar."
           styleClass="texto-suave" wrapText="true"/>

    <Region prefHeight="4"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" styleClass="boton-secundario" cancelButton="true" onAction="#cancelar"/>
        <Button text="Registrar cobro" styleClass="boton-primario" defaultButton="true" onAction="#aceptar"/>
    </HBox>
</VBox>
