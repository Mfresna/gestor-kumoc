<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="contenido" spacing="12"
      prefWidth="720" fx:controller="org.kumoc.controller.PresupuestoDialogController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="lblTitulo" text="NUEVO PRESUPUESTO" styleClass="titulo-seccion"/>

    <VBox spacing="3">
        <Label text="CLIENTE *" styleClass="etiqueta-campo"/>
        <HBox spacing="10">
            <ComboBox fx:id="cmbCliente" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNuevoCliente" text="+ Nuevo cliente" styleClass="boton-secundario"
                    onAction="#nuevoCliente"/>
        </HBox>
    </VBox>

    <VBox fx:id="panelItems" styleClass="tarjeta" spacing="10">
        <Label text="AGREGAR PRODUCTO" styleClass="subtitulo"/>
        <HBox spacing="10" alignment="BOTTOM_LEFT">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="PRODUCTO" styleClass="etiqueta-campo"/>
                <ComboBox fx:id="cmbProducto" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="3" prefWidth="90">
                <Label text="CANTIDAD" styleClass="etiqueta-campo"/>
                <TextField fx:id="txtCantidad" text="1"/>
            </VBox>
            <VBox spacing="3" prefWidth="130">
                <Label text="PRECIO UNIT." styleClass="etiqueta-campo"/>
                <TextField fx:id="txtPrecio"/>
            </VBox>
            <Button text="Agregar" styleClass="boton-primario" onAction="#agregar"/>
        </HBox>

        <TableView fx:id="tabla" prefHeight="230">
            <columns>
                <TableColumn fx:id="colProducto" text="PRODUCTO" prefWidth="300"/>
                <TableColumn fx:id="colCantidad" text="CANT." prefWidth="70" style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colPrecio" text="PRECIO UNIT." prefWidth="130"
                             style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colSubtotal" text="SUBTOTAL" prefWidth="130"
                             style="-fx-alignment: CENTER-RIGHT;"/>
            </columns>
        </TableView>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Quitar seleccionado" styleClass="boton-secundario" onAction="#quitar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="TOTAL" styleClass="etiqueta-campo"/>
            <Label fx:id="lblTotal" styleClass="total"/>
        </HBox>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" styleClass="boton-secundario" cancelButton="true" onAction="#cancelar"/>
        <Button fx:id="btnBaja" text="DAR DE BAJA" styleClass="boton-secundario" onAction="#darDeBaja"/>
        <Button fx:id="btnPrincipal" text="GUARDAR NUEVO" styleClass="boton-primario"
                onAction="#accionPrincipal"/>
    </HBox>
</VBox>
