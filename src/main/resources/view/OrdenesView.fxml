<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="12"
      fx:controller="org.kumoc.controller.OrdenesController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="ÓRDENES DE TRABAJO" styleClass="titulo-seccion"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbFiltro" prefWidth="280"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" text="N°" prefWidth="60"/>
            <TableColumn fx:id="colFecha" text="FECHA" prefWidth="100"/>
            <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="230"/>
            <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="130"/>
            <TableColumn fx:id="colCobro" text="COBRO" prefWidth="230"/>
            <TableColumn fx:id="colArca" text="ARCA" prefWidth="130"/>
        </columns>
    </TableView>

    <HBox spacing="16">
        <VBox styleClass="tarjeta" spacing="8" HBox.hgrow="ALWAYS">
            <Label fx:id="lblDetalle" text="DETALLE" styleClass="subtitulo"/>
            <Label fx:id="lblResumen" styleClass="texto-suave"/>
            <TableView fx:id="tablaItems" prefHeight="150">
                <columns>
                    <TableColumn fx:id="colItemProducto" text="PRODUCTO" prefWidth="300"/>
                    <TableColumn fx:id="colItemPedido" text="PEDIDO" prefWidth="80"
                                 style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colItemFisico" text="STOCK FÍSICO" prefWidth="110"
                                 style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn fx:id="colItemFaltante" text="FALTA FABRICAR" prefWidth="130"
                                 style="-fx-alignment: CENTER-RIGHT;"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="tarjeta" spacing="10" prefWidth="260" minWidth="260">
            <Label text="ACCIONES" styleClass="subtitulo"/>
            <Button fx:id="btnFabricacion" text="Registrar fabricación" styleClass="boton-secundario"
                    maxWidth="Infinity" onAction="#registrarFabricacion"/>
            <Button fx:id="btnVenta" text="Pasar a venta" styleClass="boton-primario" maxWidth="Infinity"
                    onAction="#pasarAVenta"/>
            <Button fx:id="btnCobro" text="Registrar cobro" styleClass="boton-secundario" maxWidth="Infinity"
                    onAction="#registrarCobro"/>
            <Button fx:id="btnFacturada" text="Marcar facturada en ARCA" styleClass="boton-secundario"
                    maxWidth="Infinity" onAction="#marcarFacturada"/>
            <Button fx:id="btnFaltantes" text="Imprimir faltantes (PDF)" styleClass="boton-secundario"
                    maxWidth="Infinity" onAction="#imprimirFaltantes"/>
            <Button fx:id="btnEliminar" text="Eliminar orden" styleClass="boton-secundario" maxWidth="Infinity"
                    onAction="#eliminarOrden"/>
        </VBox>
    </HBox>
</VBox>
