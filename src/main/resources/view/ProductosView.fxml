<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="16"
      fx:controller="org.kumoc.controller.ProductosController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="PRODUCTOS" styleClass="titulo-seccion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="chkBajas" text="Ver dados de baja"/>
            <TextField fx:id="txtBuscar" promptText="Buscar por código, nombre, talle o color" prefWidth="300"/>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colImagen" text="" prefWidth="56" minWidth="56" maxWidth="56" sortable="false"/>
                <TableColumn fx:id="colCodigo" text="CÓDIGO" prefWidth="100"/>
                <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="190"/>
                <TableColumn fx:id="colTalle" text="TALLE" prefWidth="70"/>
                <TableColumn fx:id="colColor" text="COLOR" prefWidth="100"/>
                <TableColumn fx:id="colPrecio" text="PRECIO" prefWidth="110" style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colMinimo" text="MÍN." prefWidth="60" style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <VBox styleClass="tarjeta" spacing="10" prefWidth="340" minWidth="340" maxWidth="340">
        <Label fx:id="lblFormTitulo" text="NUEVO PRODUCTO" styleClass="subtitulo"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane styleClass="imagen-marco" prefWidth="120" prefHeight="120" minWidth="120" minHeight="120"
                       maxWidth="120" maxHeight="120">
                <ImageView fx:id="imgPreview" fitWidth="116" fitHeight="116" preserveRatio="true" smooth="true"/>
                <Label fx:id="lblSinImagen" text="Sin imagen" styleClass="texto-suave"/>
            </StackPane>
            <VBox spacing="8">
                <Button fx:id="btnElegirImagen" text="Elegir imagen…" styleClass="boton-secundario"
                        onAction="#elegirImagen"/>
                <Button fx:id="btnQuitarImagen" text="Quitar imagen" styleClass="boton-secundario"
                        onAction="#quitarImagen"/>
            </VBox>
        </HBox>

        <VBox spacing="3">
            <Label text="CÓDIGO" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtCodigo"/>
        </VBox>
        <VBox spacing="3">
            <Label text="NOMBRE *" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtNombre"/>
        </VBox>
        <HBox spacing="10">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="TALLE" styleClass="etiqueta-campo"/>
                <TextField fx:id="txtTalle"/>
            </VBox>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="COLOR" styleClass="etiqueta-campo"/>
                <TextField fx:id="txtColor"/>
            </VBox>
        </HBox>
        <VBox spacing="3">
            <Label text="PÚBLICO OBJETIVO" styleClass="etiqueta-campo"/>
            <TextField fx:id="txtPublico" promptText="Adulto, niño, mascota…"/>
        </VBox>
        <VBox spacing="3">
            <Label text="DESCRIPCIÓN" styleClass="etiqueta-campo"/>
            <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true"/>
        </VBox>
        <HBox spacing="10">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="PRECIO *" styleClass="etiqueta-campo"/>
                <TextField fx:id="txtPrecio" promptText="0,00"/>
            </VBox>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="STOCK MÍNIMO" styleClass="etiqueta-campo"/>
                <TextField fx:id="txtMinimo" promptText="0"/>
            </VBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>
        <HBox spacing="10">
            <Button text="Nuevo" styleClass="boton-secundario" onAction="#nuevo"/>
            <Button fx:id="btnPrincipal" text="GUARDAR NUEVO" styleClass="boton-primario"
                    onAction="#accionPrincipal" HBox.hgrow="ALWAYS" maxWidth="Infinity" defaultButton="true"/>
        </HBox>
        <Button fx:id="btnBaja" text="DAR DE BAJA" styleClass="boton-secundario" maxWidth="Infinity"
                onAction="#cambiarBaja"/>
    </VBox>
</HBox>
