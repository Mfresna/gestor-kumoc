<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kumoc.controller.MainController">
    <left>
        <VBox minWidth="230" prefWidth="230" styleClass="sidebar">
            <ImageView fitWidth="190" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../img/logo.png" />
                </image>
                <VBox.margin>
                    <Insets bottom="28" left="20" right="20" top="24" />
                </VBox.margin>
            </ImageView>

            <Button fx:id="btnProductos" maxWidth="Infinity" onAction="#mostrarProductos" styleClass="nav-button" text="PRODUCTOS" />
            <Button fx:id="btnClientes" maxWidth="Infinity" onAction="#mostrarClientes" styleClass="nav-button" text="CLIENTES" />
            <Button fx:id="btnPresupuestos" maxWidth="Infinity" onAction="#mostrarPresupuestos" styleClass="nav-button" text="PRESUPUESTOS" />
            <Button fx:id="btnOrdenes" maxWidth="Infinity" onAction="#mostrarOrdenes" styleClass="nav-button" text="ÓRDENES DE TRABAJO" />
            <StackPane>
                <Button fx:id="btnStock" maxWidth="Infinity" onAction="#mostrarStock" styleClass="nav-button" text="STOCK" />
                <Label fx:id="badgeStock" mouseTransparent="true" styleClass="badge" StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin>
                        <Insets right="16" />
                    </StackPane.margin>
                </Label>
            </StackPane>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contenido" styleClass="contenido" />
    </center>
</BorderPane>
