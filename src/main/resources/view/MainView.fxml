<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.kumoc.controller.MainController">
    <left>
        <VBox styleClass="sidebar" prefWidth="230" minWidth="230">
            <ImageView fitWidth="190" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../img/logo.png"/>
                </image>
                <VBox.margin>
                    <Insets top="24" right="20" bottom="28" left="20"/>
                </VBox.margin>
            </ImageView>

            <Button fx:id="btnProductos" text="PRODUCTOS" styleClass="nav-button" maxWidth="Infinity"
                    onAction="#mostrarProductos"/>
            <Button fx:id="btnClientes" text="CLIENTES" styleClass="nav-button" maxWidth="Infinity"
                    onAction="#mostrarClientes"/>
            <Button fx:id="btnPresupuestos" text="PRESUPUESTOS" styleClass="nav-button" maxWidth="Infinity"
                    onAction="#mostrarPresupuestos"/>
            <Button fx:id="btnOrdenes" text="ÓRDENES DE TRABAJO" styleClass="nav-button" maxWidth="Infinity"
                    onAction="#mostrarOrdenes"/>
            <StackPane>
                <Button fx:id="btnStock" text="STOCK" styleClass="nav-button" maxWidth="Infinity"
                        onAction="#mostrarStock"/>
                <Label fx:id="badgeStock" styleClass="badge" StackPane.alignment="CENTER_RIGHT"
                       mouseTransparent="true">
                    <StackPane.margin>
                        <Insets right="16"/>
                    </StackPane.margin>
                </Label>
            </StackPane>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Gestión de stock y ventas" styleClass="sidebar-pie">
                <VBox.margin>
                    <Insets left="20"/>
                </VBox.margin>
            </Label>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contenido" styleClass="contenido"/>
    </center>
</BorderPane>
